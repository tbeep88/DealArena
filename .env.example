# Read-only product pages work without these secrets.
# Every payment action stays unavailable until the Tempo readiness checks pass.
# Never commit a real private key.
TEMPO_PRIVATE_KEY=
TEMPO_RPC_URL=https://rpc.moderato.tempo.xyz
TEMPO_CHAIN_ID=42431
TEMPO_PUBLIC_DEMO=false
# Keep public LIVE writes off except for a controlled presenter machine.
TEMPO_PRESENTER_MODE=false
# Required when public presenter mode is enabled. Use a long random value and
# send it through the presenter session/proxy, never expose it in public HTML.
TEMPO_PRESENTER_TOKEN=
HOST=127.0.0.1
PORT=4184

# Dedicated testnet-only keys. Without one mnemonic or all role keys,
# LIVE_TESTNET is disabled and no payment is simulated as completed.
# TEMPO_DEMO_MNEMONIC=
# TEMPO_DEMO_BUYER_PRIVATE_KEY=
# TEMPO_DEMO_SELLER_A_PRIVATE_KEY=
# TEMPO_DEMO_SELLER_B_PRIVATE_KEY=
# TEMPO_DEMO_SELLER_C_PRIVATE_KEY=
